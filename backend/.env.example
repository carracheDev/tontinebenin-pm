DATABASE_URL="postgresql://user:password@localhost:5432/tontinebenin_pm"
JWT_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=3100

# ── Assistant IA (Phase 8) ──
IA_PROVIDER=none
IA_MODELE=gemini-2.0-flash
GEMINI_API_KEY=
GROQ_MODELE=llama-3.3-70b-versatile
GROQ_API_KEY=

# ── Réunions vidéo — 8x8 JaaS (Jitsi as a Service) ──
# Sans ces variables : mode démo meet.jit.si (limité à 5 min).
# À créer sur https://jaas.8x8.vc (compte gratuit) :
#   JAAS_APP_ID       = l'AppID (commence par "vpaas-magic-cookie-…")
#   JAAS_KID          = l'ID de la clé API (format "vpaas-magic-cookie-…/xxxxx")
#   JAAS_PRIVATE_KEY  = la clé privée RSA sur UNE ligne, retours à la ligne en \n
# OU, plus simple : déposer le fichier .pk sur le serveur et renseigner son chemin
#   JAAS_PRIVATE_KEY_PATH = /chemin/vers/cle-privee.pk   (prioritaire sur JAAS_PRIVATE_KEY)
JAAS_APP_ID=
JAAS_KID=
JAAS_PRIVATE_KEY=
JAAS_PRIVATE_KEY_PATH=
